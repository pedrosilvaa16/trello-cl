# Copiar para .env.local e preencher com as chaves do projeto Supabase.
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Só no servidor. Ignora RLS por completo — nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: chave anon legada (JWT), para ferramentas que ainda não aceitam
# o formato sb_publishable_.
SUPABASE_ANON_KEY_LEGADO=

# Trello — só durante a migração, podem sair daqui depois.
# O token não é o "Segredo" do painel: gera-se em /1/authorize com scope=read.
TRELLO_API_KEY=
TRELLO_TOKEN=

# Resend — envio dos convites por email. Sem isto os convites continuam a ser
# criados; só têm de ser enviados à mão, copiando o link do painel.
# O remetente tem de estar num domínio verificado em resend.com/domains —
# caso contrário o Resend recusa o envio e diz-lo na mensagem de erro.


# Cloudflare R2 — onde vivem os anexos. As credenciais nunca saem do servidor.
R2_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quadros-anexos

# ---------------------------------------------------------------------------
# Estatísticas de redes sociais — ver README, "Ligar as redes sociais"
# ---------------------------------------------------------------------------

# Onde a aplicação vive. Fixo e sem barra no fim.
# O redirect_uri do OAuth tem de ser byte a byte igual ao que está registado em
# cada plataforma, e por isso NÃO se monta a partir dos cabeçalhos do pedido:
# por trás da Vercel o host muda entre produção e pré-visualização.
APP_URL=https://quadros.creativeline.pt

# Cifra dos tokens guardados em ligacoes_segredos. 32 bytes.
# Gerar com:  openssl rand -base64 32
# Trocar esta chave invalida todas as ligações — todas terão de ser refeitas.
CHAVE_CIFRA_REDES=

# Meta — uma app serve o Instagram e o Facebook.
# developers.facebook.com → a tua app → Definições → Básico
META_APP_ID=
META_APP_SECRET=
# Opcional. A versão fica fixada de propósito: a Meta muda o significado das
# métricas entre versões, e um painel que seguisse a última mudava sozinho.
# META_API_VERSAO=v23.0

# LinkedIn — à espera de aprovação da Community Management API.
# Sem estas duas, o botão aparece a cinzento e diz porquê.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok — à espera de aprovação em developers.tiktok.com.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Segredo do cron diário que grava as métricas. Gerar com:
#   openssl rand -hex 32
# Na Vercel é preenchido automaticamente se existir como variável do projeto.
CRON_SECRET=
